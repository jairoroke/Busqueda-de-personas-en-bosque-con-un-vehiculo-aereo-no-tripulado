<?xml version="1.0" encoding="UTF-8"?>
<!-- Generado por scripts/generar_vehiculo.py; no editar a mano.
     Tarot Ironman 650 en configuración "X" (2.2 kg, MN3508, hélices 15"): la tabla VEHICULOS['tarot650'] de cuadrirotor_sim.
     kf = 4.24e-05 N/(rad/s)^2, km = 0.016 m, w_max = 680.0 rad/s. -->
<sdf version='1.9'>
  <model name='tarot650_busqueda_ardupilot'>
    <pose>0 0 0.235 0 0 0</pose>
    <self_collide>false</self_collide>
    <static>false</static>
    <link name="base_link">
      <!-- IMU que lee ArduPilot (marco NED: girada 180 grados en x), con ruido y sesgo
           del orden de la IMU de una Pixhawk más la vibración del marco (supuestos). Sin
           ruido el EKF integra la inercia casi perfecta. -->
      <sensor name="imu_ardupilot" type="imu">
        <pose degrees="true">0 0 0 180 0 0</pose>
        <always_on>1</always_on>
        <update_rate>1000</update_rate>
        <imu>
          <angular_velocity>
            <x><noise type="gaussian"><mean>0</mean><stddev>0.004</stddev><bias_mean>0</bias_mean><bias_stddev>0.003</bias_stddev><dynamic_bias_stddev>0.0003</dynamic_bias_stddev><dynamic_bias_correlation_time>300</dynamic_bias_correlation_time></noise></x>
            <y><noise type="gaussian"><mean>0</mean><stddev>0.004</stddev><bias_mean>0</bias_mean><bias_stddev>0.003</bias_stddev><dynamic_bias_stddev>0.0003</dynamic_bias_stddev><dynamic_bias_correlation_time>300</dynamic_bias_correlation_time></noise></y>
            <z><noise type="gaussian"><mean>0</mean><stddev>0.004</stddev><bias_mean>0</bias_mean><bias_stddev>0.003</bias_stddev><dynamic_bias_stddev>0.0003</dynamic_bias_stddev><dynamic_bias_correlation_time>300</dynamic_bias_correlation_time></noise></z>
          </angular_velocity>
          <linear_acceleration>
            <x><noise type="gaussian"><mean>0</mean><stddev>0.1</stddev><bias_mean>0</bias_mean><bias_stddev>0.04</bias_stddev><dynamic_bias_stddev>0.003</dynamic_bias_stddev><dynamic_bias_correlation_time>300</dynamic_bias_correlation_time></noise></x>
            <y><noise type="gaussian"><mean>0</mean><stddev>0.1</stddev><bias_mean>0</bias_mean><bias_stddev>0.04</bias_stddev><dynamic_bias_stddev>0.003</dynamic_bias_stddev><dynamic_bias_correlation_time>300</dynamic_bias_correlation_time></noise></y>
            <z><noise type="gaussian"><mean>0</mean><stddev>0.1</stddev><bias_mean>0</bias_mean><bias_stddev>0.04</bias_stddev><dynamic_bias_stddev>0.003</dynamic_bias_stddev><dynamic_bias_correlation_time>300</dynamic_bias_correlation_time></noise></z>
          </linear_acceleration>
        </imu>
      </sensor>
      <enable_wind>true</enable_wind>
      <inertial>
        <mass>2.12</mass>
        <inertia>
          <ixx>0.0304</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.0321</iyy><iyz>0</iyz><izz>0.0585</izz>
        </inertia>
      </inertial>
      <gravity>true</gravity>
      <velocity_decay />
      <collision name="cuerpo_col">
        <geometry><box><size>0.16 0.16 0.06</size></box></geometry>
      </collision>
      <collision name="pata_0">
        <pose>0 -0.1065 -0.2205 0 1.5707963 0</pose>
        <geometry><cylinder><radius>0.005</radius><length>0.2</length></cylinder></geometry>
      </collision>
      <collision name="pata_1">
        <pose>0 0.1065 -0.2205 0 1.5707963 0</pose>
        <geometry><cylinder><radius>0.005</radius><length>0.2</length></cylinder></geometry>
      </collision>
      <visual name="placas">
        <geometry><mesh><uri>model://tarot650_busqueda/meshes/placas.stl</uri></mesh></geometry>
        <material><ambient>0.09 0.09 0.1 1</ambient><diffuse>0.09 0.09 0.1 1</diffuse><specular>0.3 0.3 0.3 1</specular></material>
      </visual>
      <visual name="brazos">
        <geometry><mesh><uri>model://tarot650_busqueda/meshes/brazos.stl</uri></mesh></geometry>
        <material><ambient>0.06 0.06 0.07 1</ambient><diffuse>0.06 0.06 0.07 1</diffuse><specular>0.3 0.3 0.3 1</specular></material>
      </visual>
      <visual name="acentos">
        <geometry><mesh><uri>model://tarot650_busqueda/meshes/acentos.stl</uri></mesh></geometry>
        <material><ambient>0.9 0.42 0.08 1</ambient><diffuse>0.9 0.42 0.08 1</diffuse><specular>0.3 0.3 0.3 1</specular></material>
      </visual>
      <visual name="tren">
        <geometry><mesh><uri>model://tarot650_busqueda/meshes/tren.stl</uri></mesh></geometry>
        <material><ambient>0.16 0.16 0.17 1</ambient><diffuse>0.16 0.16 0.17 1</diffuse><specular>0.3 0.3 0.3 1</specular></material>
      </visual>
      <visual name="motores">
        <geometry><mesh><uri>model://tarot650_busqueda/meshes/motores.stl</uri></mesh></geometry>
        <material><ambient>0.72 0.72 0.75 1</ambient><diffuse>0.72 0.72 0.75 1</diffuse><specular>0.3 0.3 0.3 1</specular></material>
      </visual>
      <visual name="marco">
        <geometry><mesh><uri>model://tarot650_busqueda/meshes/marco.stl</uri></mesh></geometry>
        <material><ambient>0.6 0.6 0.62 1</ambient><diffuse>0.6 0.6 0.62 1</diffuse><specular>0.3 0.3 0.3 1</specular></material>
      </visual>
      <sensor name="air_pressure_sensor" type="air_pressure">
        <gz_frame_id>base_link</gz_frame_id>
        <always_on>1</always_on>
        <update_rate>50</update_rate>
        <air_pressure>
          <!-- Noise modeled after BMP390 -->
          <pressure>
            <noise type="gaussian">
              <mean>0</mean>
              <stddev>3</stddev>
            </noise>
          </pressure>
        </air_pressure>
      </sensor>
      <sensor name="magnetometer_sensor" type="magnetometer">
        <gz_frame_id>base_link</gz_frame_id>
        <always_on>1</always_on>
        <update_rate>100</update_rate>
        <magnetometer>
          <!-- TODO: update to fix units and coordinate system when we move past Harmonic -->
          <!-- See https://github.com/gazebosim/gz-sim/pull/2460 -->
          <!-- 3mgauss RMS: NOTE: noise is in tesla but sensor reports data in gauss -->
          <!-- Noise modeled after IIS2MDC -->
          <x>
            <noise type="gaussian">
              <stddev>0.0001</stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <stddev>0.0001</stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <stddev>0.0001</stddev>
            </noise>
          </z>
        </magnetometer>
      </sensor>
      <sensor name="imu_sensor" type="imu">
        <gz_frame_id>base_link</gz_frame_id>
        <always_on>1</always_on>
        <update_rate>250</update_rate>
        <imu>
          <angular_velocity>
            <!-- Noise modeled after IIM42653 -->
            <!-- 0.05 deg/s converted to rad/s -->
            <x>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.0008726646</stddev>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.0008726646</stddev>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.0008726646</stddev>
              </noise>
            </z>
          </angular_velocity>
          <linear_acceleration>
            <!-- Noise modeled after IIM42653 -->
            <!-- X & Y axis: 0.65 mg-rms converted to m/ss -->
            <x>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.00637</stddev>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.00637</stddev>
              </noise>
            </y>
            <!-- Z axis: 0.70 mg-rms converted to m/ss-->
            <z>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.00686</stddev>
              </noise>
            </z>
          </linear_acceleration>
        </imu>
      </sensor>
      <sensor name="navsat_sensor" type="navsat">
        <gz_frame_id>base_link</gz_frame_id>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
      </sensor>
      <sensor name="lidar" type="gpu_lidar">
        <pose>0 0 0.1 0 0 0</pose>
        <always_on>1</always_on>
        <update_rate>10</update_rate>
        <topic>dron/lidar</topic>
        <lidar>
          <scan>
            <horizontal><samples>120</samples><min_angle>-3.14159</min_angle><max_angle>3.14159</max_angle></horizontal>
            <vertical><samples>16</samples><min_angle>-0.6109</min_angle><max_angle>0.2618</max_angle></vertical>
          </scan>
          <range><min>0.8</min><max>30</max><resolution>0.05</resolution></range>
        </lidar>
      </sensor>
    </link>
    <link name="rotor_0">
      <pose>0.2198 -0.212 0.04 0 0 0</pose>
      <inertial>
        <mass>0.02</mass>
        <inertia>
          <ixx>2e-07</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.00024</iyy><iyz>0</iyz><izz>0.00024</izz>
