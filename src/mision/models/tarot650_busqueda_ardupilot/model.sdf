        <inertia>
          <ixx>2e-07</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.00024</iyy><iyz>0</iyz><izz>0.00024</izz>
        </inertia>
      </inertial>
      <visual name="helice">
        <geometry><mesh><uri>model://tarot650_busqueda/meshes/helice_1.stl</uri></mesh></geometry>
        <material><ambient>0.9 0.35 0.05 1</ambient><diffuse>0.9 0.35 0.05 1</diffuse></material>
      </visual>
    </link>
    <link name="rotor_3">
      <pose>-0.2198 -0.212 0.04 0 0 0</pose>
      <inertial>
