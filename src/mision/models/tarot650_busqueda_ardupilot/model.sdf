    <plugin filename="SelectorMotores" name="mision::SelectorMotores">
      <entrada>/dron/ap/motor_0</entrada>
      <entrada>/dron/ap/motor_1</entrada>
      <entrada>/dron/ap/motor_2</entrada>
      <entrada>/dron/ap/motor_3</entrada>
      <red>/dron/red/motor_speed</red>
      <modo>/dron/controlador</modo>
